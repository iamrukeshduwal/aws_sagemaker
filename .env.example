# Copy this file to .env.local and fill in the values. .env.local is never committed.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# true = fake detections, no AWS calls (use while the endpoint is deleted)
USE_MOCK=false

SAGEMAKER_REGION=ap-southeast-2
SAGEMAKER_ENDPOINT_NAME=yolo26n-endpoint

# Keys of the IAM user "vision-demo-invoker" (only allowed to call InvokeEndpoint)
SAGEMAKER_ACCESS_KEY_ID=
SAGEMAKER_SECRET_ACCESS_KEY=
